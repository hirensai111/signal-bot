{
 "uid": "signal-bot-overview",
 "title": "Signal Bot: overview",
 "description": "Paper deployment: health, trading performance, risk and logs.",
 "tags": [
  "signal-bot"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "links": [
  {
   "title": "Control room (halt needs the operator token)",
   "type": "link",
   "url": "${control_room}",
   "targetBlank": true,
   "icon": "external link"
  },
  {
   "title": "Operations detail",
   "type": "dashboards",
   "tags": [
    "signal-bot"
   ],
   "asDropdown": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "bot",
    "label": "Bot",
    "type": "custom",
    "query": "Main (trailing stop) : bot,TP 1.5R (fixed exit) : bot-tp",
    "current": {
     "text": "Main (trailing stop)",
     "value": "bot"
    },
    "options": [
     {
      "text": "Main (trailing stop)",
      "value": "bot",
      "selected": true
     },
     {
      "text": "TP 1.5R (fixed exit)",
      "value": "bot-tp",
      "selected": false
     }
    ]
   },
   {
    "name": "tradedb",
    "label": "Trade database",
    "type": "datasource",
    "query": "grafana-postgresql-datasource",
    "regex": "/^Signal Bot DB/",
    "current": {
     "text": "Signal Bot DB",
     "value": "signalbot-db"
    }
   },
   {
    "name": "control_room",
    "label": "Control room URL",
    "type": "textbox",
    "query": "http://127.0.0.1:8080/",
    "current": {
     "text": "http://127.0.0.1:8080/",
     "value": "http://127.0.0.1:8080/"
    },
    "hide": 2
   },
   {
    "name": "level",
    "label": "Level",
    "type": "custom",
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "query": "DEBUG,INFO,WARNING,ERROR,CRITICAL",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "subsystem",
    "label": "Subsystem",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "subsystem",
     "stream": "{service=\"$bot\"}",
     "type": 1,
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "refresh": 2,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "search",
    "label": "Search",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   },
   {
    "name": "symbol",
    "label": "Symbol",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   },
   {
    "name": "order",
    "label": "Order id",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Bot restarts",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "changes(process_start_time_seconds{job=\"signal-bot\", instance=\"${bot}:8080\"}[2m]) > 0",
    "step": "60s",
    "titleFormat": "Bot restarted"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Bot",
   "description": "Prometheus can scrape the bot's /metrics.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"signal-bot\", instance=\"${bot}:8080\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Online",
         "color": "green"
        },
        "0": {
         "text": "Offline",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   }
  },
