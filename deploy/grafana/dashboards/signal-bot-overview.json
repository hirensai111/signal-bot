  {
   "id": 43,
   "type": "logs",
   "title": "Bot logs (filter with the variables at the top)",
   "description": "Level, logger and message per line; expand a line for symbol, order and correlation ids. Paste a signal's correlation id into 'search' to follow one trade.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 86,
    "w": 24,
    "h": 16
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=\"$bot\", level=~\"$level\", subsystem=~\"$subsystem\"} |~ \"(?i)$search\" | symbol=~\"(?i).*$symbol.*\" | order_id=~\".*$order.*\" | json msg=\"msg\", exc=\"exc\" | line_format `{{ printf \"%-8s\" .level }} {{ .logger }}  {{ if .msg }}{{ .msg }}{{ else }}{{ __line__ }}{{ end }}{{ if .symbol }}  [{{ .symbol }}]{{ end }}{{ if .exc }}\n{{ .exc }}{{ end }}`",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "prettifyLogMessage": false,
    "dedupStrategy": "none"
   }
  }
