  {
   "id": 18,
   "type": "stat",
   "title": "Closed trades in range",
   "description": "From the trade_results table: each closed paper trade after fees and funding. R = net P&L / intended risk.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${tradedb}"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${tradedb}"
     },
     "rawSql": "SELECT count(*) AS \"Closed trades\",\n  avg((realized_r > 0)::int) AS \"Win rate\",\n  avg(realized_r) AS \"Avg R per trade\",\n  sum(net_pnl) AS \"Net P&L\",\n  sum(fees) AS \"Fees\",\n  sum(funding) AS \"Funding\"\nFROM trade_results WHERE $__timeFilter(closed_at)",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Win rate"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "Net P&L|Fees|Funding"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyUSD"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Avg R per trade"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 3
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/.*/",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   }
  },
