  {
   "id": 7,
   "type": "timeseries",
   "title": "Market data age by symbol and interval (seconds since candle close)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "signalbot_market_data_age_seconds{instance=\"${bot}:8080\"}",
     "legendFormat": "{{symbol}} {{interval}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Exchange latency p95 by operation",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(signalbot_exchange_request_latency_seconds_bucket{instance=\"${bot}:8080\"}[5m])))",
     "legendFormat": "{{operation}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
