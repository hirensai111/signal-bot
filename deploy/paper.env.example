# Paper deployment settings: copy to .env next to docker-compose.yml.
# deploy/bootstrap-ubuntu.sh generates the four secrets below for you.
# The compose file pins EXEC_MODE=paper and PAPER_ONLY=true; no Delta API keys are needed.

# --- secrets (generated) ------------------------------------------------------
POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Required to halt/resume from the control room (send as "Authorization: Bearer ...").
OPERATOR_TOKEN=

# --- alerts -------------------------------------------------------------------------
# Telegram bot from @BotFather and your chat id. Used by Alertmanager (bot down, stale
# 4h data, missing stops, failed reconciliation, excessive risk) and by the bot itself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional dead man's switch (e.g. a healthchecks.io ping URL): pinged every few
# minutes while alerting works; that service tells you when the pings stop.
DEADMANS_SWITCH_URL=

# --- remote access -------------------------------------------------------------------
# Set by the bootstrap script to your Tailscale address, e.g. https://signal-bot.tailnet-name.ts.net/
GRAFANA_ROOT_URL=

# --- trading (paper) -----------------------------------------------------------------------
# Delta order books the paper broker fills against: testnet lists 6 of the 11 coins,
# production (public data only, no keys) lists all 11.
DELTA_MODE=production
PAPER_INITIAL_EQUITY=10000
# Market data only; the bot never trades on Binance. Must stay false.
BINANCE_TESTNET=false
# Second paper bot (same entries, fixed +1.5R take-profit, no trailing stop) on its own
# $10k account, database and control room (127.0.0.1:8081). Uncomment to run it; every
# docker compose command, including deploy/update.sh, then includes it.
#COMPOSE_PROFILES=tp

# --- backups ------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
