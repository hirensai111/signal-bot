# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/signal_bot

# Execution: paper (default; realistic fills on live Delta order books) or live
EXEC_MODE=paper
# Required in addition to EXEC_MODE=live with DELTA_MODE=production (see docs/runbook.md)
LIVE_TRADING_ACKNOWLEDGED=false
ORDER_TYPE=limit_ioc
NO_FILL_TIMEOUT_SECONDS=60
MAX_CANDLE_LAG_SECONDS=90
MAX_BOOK_AGE_SECONDS=10

# Binance (market data)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Telegram (notifications only; health lives in /metrics and the control room)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk parameters
ACCOUNT_SIZE_USDT=10000
RISK_PCT_PER_TRADE=1.0
MAX_LEVERAGE=20

# Delta Exchange India
DELTA_MODE=testnet
DELTA_API_KEY=
DELTA_API_SECRET=

# Risk governor limits
DAILY_LOSS_LIMIT_R=-3.0
MAX_TRADES_PER_DAY=10
MAX_CONCURRENT_POSITIONS=3
MAX_CONSECUTIVE_LOSSES=5
MIN_BALANCE_USDT=50

# Reconciliation
RECONCILE_INTERVAL_SECONDS=300
UNKNOWN_ORDER_GRACE_SECONDS=300
BLOCK_ON_ORPHAN_POSITIONS=true

# Paper broker
PAPER_TAKER_FEE=0.0005
PAPER_MAKER_FEE=0.0002
PAPER_LATENCY_MS=150
PAPER_FUNDING_RATE=0.0001
PAPER_STATE_PATH=data/paper_state.json

# Ops server: metrics, health, control room. Control endpoints are disabled without a token.
OPS_HOST=127.0.0.1
OPS_PORT=8080
OPERATOR_TOKEN=

# Logging: json or text
LOG_LEVEL=INFO
LOG_FORMAT=json
